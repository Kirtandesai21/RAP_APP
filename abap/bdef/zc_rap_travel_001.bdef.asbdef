projection;
strict ( 2 );
use draft;

define behavior for ZC_RAP_TRAVEL_001 alias Travel
{
  use create;
  use update;
  use delete;

  use action acceptTravel;
  use action rejectTravel;
  use action recalcTotalPrice;

  use association _Booking { create; with draft; }

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
}

define behavior for ZC_RAP_BOOKING_001 alias Booking
{
  use update;
  use delete;

  use association _Travel { with draft; }
}
